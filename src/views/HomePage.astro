---
/**
 * Landing page — sections in order (the same for every language).
 * To remove a section, delete its line below.
 */
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Benefits from '../components/Benefits.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import Offer from '../components/Offer.astro';
import OrderForm from '../components/OrderForm.astro';
import SizeGuideModal from '../components/SizeGuideModal.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import StickyOrderBar from '../components/StickyOrderBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/product';
---

<Layout>
  <SiteHeader />

  <main>
    <Hero />
    <Benefits />
    <Gallery />
    {site.reviews.length > 0 && <Reviews />}
    <Offer />
    <OrderForm />
    <FAQ />
    <FinalCTA />
  </main>

  <Footer home />

  <!-- Global elements -->
  <StickyOrderBar />
  <WhatsAppButton />
  <SizeGuideModal />
</Layout>

<!-- All the interactivity (Alpine.js) — see src/scripts/app.ts -->
<script>
  import '../scripts/app.ts';
</script>
