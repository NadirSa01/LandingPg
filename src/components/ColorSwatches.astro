---
/**
 * Round color swatches. Clicking one changes $store.shop.color
 * (hero image, gallery, final CTA and the first pair of the form follow).
 */
import { product } from '../config/product';
import { useT, colorLabel } from '../lib/i18n';

const { lang, t } = useT(Astro.url);
// { black: "Noir", ... } — used to show the selected color name
const labels = JSON.stringify(Object.fromEntries(product.colors.map((c) => [c.id, colorLabel(c, lang)])));
---

<fieldset>
  <legend class="mb-2 font-bold text-brand">
    {t.chooseColor}:{' '}
    <span class="font-semibold text-muted" x-text={`${labels}[$store.shop.color]`}>{colorLabel(product.colors[0], lang)}</span>
  </legend>
  <div class="flex flex-wrap gap-2 sm:gap-3">
    {
      product.colors.map((c, i) => (
        <button
          type="button"
          class="pressable flex min-h-12 items-center gap-2 rounded-full border-2 bg-white py-1 ps-1 pe-3 font-bold hover:border-cork sm:py-1.5 sm:ps-1.5 sm:pe-4"
          :class={`$store.shop.color === '${c.id}' ? 'border-brand ring-2 ring-brand/20' : 'border-line'`}
          aria-pressed={i === 0 ? 'true' : 'false'}
          :aria-pressed={`($store.shop.color === '${c.id}').toString()`}
          @click={`$store.shop.color = '${c.id}'`}
        >
          <span class="size-8 rounded-full border border-black/10 shadow-inner sm:size-9" style={`background:${c.hex}`} />
          <span>{colorLabel(c, lang)}</span>
        </button>
      ))
    }
  </div>
</fieldset>
