---
/**
 * Announcement bar — stays fixed at the top of the screen, messages scroll in a loop.
 *  - The message is topBar in the translation files.
 *  - Hover (mouse) pauses the scrolling.
 *  - "Reduce motion" setting → no scrolling, the main message is shown still.
 *  Animation: .marquee in global.css
 */
import Truck from '@lucide/astro/icons/truck';
import { useT } from '../lib/i18n';

const { t } = useT(Astro.url);

// The message is repeated so it fills even wide screens
const messages = Array(6).fill(t.topBar);
// The list is repeated so the loop is seamless (the copies are hidden from screen readers)
const copies = [0, 1];
---

<div class="sticky top-0 z-50 h-9 overflow-hidden bg-brand text-white" role="region" aria-label={t.topBar}>
  <!-- Moving version -->
  <div class="marquee flex h-full w-max items-center motion-reduce:hidden">
    {
      copies.map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {messages.map((msg, i) => (
            <li aria-hidden={i > 0 ? 'true' : undefined} class="flex items-center gap-2 px-6 text-sm font-bold whitespace-nowrap">
              <Truck class="size-4 shrink-0 text-cork" aria-hidden="true" />
              {msg}
              <span class="ms-6 size-1.5 rounded-full bg-cork/60" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <!-- Still version (only when the visitor has "reduce motion" on) -->
  <p class="container-page hidden h-full items-center justify-center gap-2 text-center text-sm font-bold motion-reduce:flex">
    <Truck class="size-4 shrink-0 text-cork" aria-hidden="true" />
    <span class="truncate">{t.topBar}</span>
  </p>
</div>
