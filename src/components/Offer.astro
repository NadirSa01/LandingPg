---
/** Bundle offer highlight (e.g. "2 أزواج غير ب 349 درهم") */
import Package from '@lucide/astro/icons/package';
import { product } from '../config/product';
import { bundleSaving } from '../lib/pricing';
import { useT, fill } from '../lib/i18n';

const { t } = useT(Astro.url);
const { pairs, totalPrice } = product.bundle;
const cur = t.currencyLabel;
---

<section id="offer" class="section" aria-labelledby="offer-title">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-[2rem] bg-brand px-6 py-10 text-center text-white shadow-soft sm:px-12 sm:py-14">
      <div class="absolute -top-16 -start-16 size-48 rounded-full bg-cork/20" aria-hidden="true"></div>
      <div class="absolute -bottom-20 -end-10 size-56 rounded-full bg-accent/20" aria-hidden="true"></div>

      <div class="relative">
        <span class="mx-auto mb-4 grid size-14 place-items-center rounded-2xl bg-white/10 text-cork">
          <Package class="size-7" aria-hidden="true" />
        </span>
        <p class="font-bold text-cork">{t.offerTitle}</p>
        <h2 id="offer-title" class="mt-2 text-[clamp(1.6rem,5vw,2.75rem)] leading-tight font-extrabold">
          {fill(t.offerHeadline, { n: pairs })} <span class="whitespace-nowrap text-[#ffb38a]">{totalPrice} {cur}</span>
        </h2>
        <p class="mt-3 text-lg text-white/85">
          {fill(t.offerInstead, { old: `${pairs * product.price} ${cur}`, saving: `${bundleSaving} ${cur}` })}
        </p>
        <p class="mt-1 text-white/75">{t.offerMix}</p>
        <a href="#order" class="btn-primary mt-7 w-full sm:w-auto sm:min-w-72">{t.offerCta}</a>
      </div>
    </div>
  </div>
</section>
